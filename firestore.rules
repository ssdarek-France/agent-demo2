rules_version = '2';

// =====================================================================
// Règles de sécurité Firestore pour SENTINEL
// À coller dans : Console Firebase > Firestore Database > onglet "Règles"
// puis cliquer sur "Publier".
//
// Principes :
//  1. Chaque utilisateur (même anonyme) ne lit et n'écrit QUE ses données,
//     rangées sous users/{son uid}/...
//  2. Liste blanche des champs : tout champ inattendu (par exemple "apiKey")
//     est refusé. La base ne peut donc pas recevoir de clé API par ce chemin.
//  3. Tout le reste de la base est fermé.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Une conversation : titre, fournisseur, modèle, dates.
    match /users/{uid}/conversations/{convId} {
      allow read, delete: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['title', 'provider', 'model', 'createdAt', 'updatedAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.provider is string
        && request.resource.data.provider.size() <= 40
        && request.resource.data.model is string
        && request.resource.data.model.size() <= 120;

      // Mise à jour : seule la date "updatedAt" peut changer.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt']);

      // Les messages de la conversation.
      match /messages/{msgId} {
        allow read, delete: if isOwner(uid);

        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['role', 'content', 'createdAt'])
          && request.resource.data.role in ['user', 'assistant']
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 30000;

        // Un message archivé ne se modifie pas.
        allow update: if false;
      }
    }

    // Tout le reste est interdit.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
